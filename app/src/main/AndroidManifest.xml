<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- JobScheduler rejects jobs with a network constraint (the upload job) without this. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only for the "needs attention" and "ask before sending" notifications; asked for at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: Play restricts it, so the user sets "Unrestricted" on the app's own battery page. -->

    <!-- Lets the app picker list launchable apps without the restricted QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Bank to Wallet"
        android:theme="@style/Theme.BankSync"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Bound by the system only when a notification arrives: no foreground service, no polling. -->
        <service
            android:name=".BankNotificationListener"
            android:exported="true"
            android:label="Bank to Wallet"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".ReviewReceiver"
            android:exported="false" />

        <!-- The opt-in daily summary's alarm. -->
        <receiver
            android:name=".SummaryReceiver"
            android:exported="false" />

        <!-- Quick Settings tile to pause and resume capture. -->
        <service
            android:name=".PauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="Bank to Wallet"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".UploadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
