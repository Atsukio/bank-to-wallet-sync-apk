<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/root"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:max="100"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/stepText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Button
            android:id="@+id/skipButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip setup" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- 0: welcome -->
            <LinearLayout
                android:id="@+id/step0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_logo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Bank to Wallet"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="When your bank app shows a notification such as &quot;You spent RM 12.30 at a shop&quot;, this app records the transaction in your BudgetBakers Wallet for you."
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="• It only looks at the bank apps you choose.\n• Transactions wait on your phone if you're offline and send themselves when you're back online.\n• It doesn't run in the background or poll, so it uses almost no battery.\n• Your Wallet token is stored encrypted on this phone."
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Setup takes about two minutes. You can skip any step and finish it later."
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- No Wallet account or bank app needed: made-up data, nothing is sent. -->
                <Button
                    android:id="@+id/obDemo"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Just looking? Try the demo" />
            </LinearLayout>

            <!-- 1: Wallet token -->
            <LinearLayout
                android:id="@+id/step1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:contentDescription="@null"
                    style="@style/Widget.BankSync.StepIcon"
                    android:src="@drawable/ic_wallet" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connect to Wallet"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/obWalletText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/obTokenLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="API token"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/obToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/obCheck"
                    style="@style/Widget.Material3.Button.TonalButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Check connection"
                    app:icon="@drawable/ic_check_circle" />

                <TextView
                    android:id="@+id/obTokenStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>

            <!-- 2: notification access -->
            <LinearLayout
                android:id="@+id/step2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:contentDescription="@null"
                    style="@style/Widget.BankSync.StepIcon"
                    android:src="@drawable/ic_notifications" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allow notification access"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="To record transactions, the app reads the notifications from the bank apps you choose: the amount, who was paid or who paid you, the reference and the time. Notifications from other apps are ignored and never stored, and the details go only to your own Wallet account.\n\nAndroid needs you to switch this on yourself: tap the button, then turn on the switch for Bank to Wallet."
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Button
                    android:id="@+id/obAccessButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Open notification access" />

                <TextView
                    android:id="@+id/obAccessStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>

            <!-- 3: battery -->
            <LinearLayout
                android:id="@+id/step3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:contentDescription="@null"
                    style="@style/Widget.BankSync.StepIcon"
                    android:src="@drawable/ic_battery" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Keep it reliable"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Some phones stop notification listeners to save battery, which means missed transactions. This app does no background work of its own, so allowing unrestricted battery use costs almost nothing.\n\nTap the button, then Battery (or App battery usage), and choose Unrestricted. This step is optional."
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <Button
                    android:id="@+id/obBatteryButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Allow unrestricted battery" />

                <TextView
                    android:id="@+id/obBatteryStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>

            <!-- 4: bank apps -->
            <LinearLayout
                android:id="@+id/step4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:contentDescription="@null"
                    style="@style/Widget.BankSync.StepIcon"
                    android:src="@drawable/ic_apps" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose your bank apps"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Pick each app that sends transaction alerts, then the Wallet account its transactions belong to. Your accounts come straight from Wallet.\n\nIf an app covers several cards (for example a Maybank app with more than one card), you can send some alerts to a different account: when asked, enter the card's last 4 digits, then add the app again for the next card."
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <LinearLayout
                    android:id="@+id/obRules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/obAddApp"
                    style="@style/Widget.Material3.Button.TonalButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Add bank app"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <!-- 5: preferences -->
            <LinearLayout
                android:id="@+id/step5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:contentDescription="@null"
                    style="@style/Widget.BankSync.StepIcon"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How should it behave?"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="The usual choices are already set. Change any of them now or later in Settings."
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/obReviewSwitch"
                    style="@style/Widget.BankSync.SettingSwitch"
                    android:layout_marginTop="8dp"
                    android:text="Ask before sending" />

                <TextView
                    style="@style/Widget.BankSync.SettingHint"
                    android:text="Each transaction waits for you to tap Send in a notification. Off, they go to Wallet straight away." />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/obAskNoCategorySwitch"
                    style="@style/Widget.BankSync.SettingSwitch"
                    android:text="Ask when there's no category" />

                <TextView
                    style="@style/Widget.BankSync.SettingHint"
                    android:text="Only transactions no category could be picked for wait for you. Off, they go to Wallet as Unknown." />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/obCapturedSwitch"
                    style="@style/Widget.BankSync.SettingSwitch"
                    android:text="Tell me when a transaction is picked up" />

                <TextView
                    style="@style/Widget.BankSync.SettingHint"
                    android:text="A silent notification with the amount, account and category, with Change and Don't send." />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/obSummarySwitch"
                    style="@style/Widget.BankSync.SettingSwitch"
                    android:text="Daily summary" />

                <TextView
                    style="@style/Widget.BankSync.SettingHint"
                    android:text="Around 9 pm: how many transactions went to Wallet that day, and anything that needs you." />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/obWifiSwitch"
                    style="@style/Widget.BankSync.SettingSwitch"
                    android:text="Wi-Fi only" />

                <TextView
                    style="@style/Widget.BankSync.SettingHint"
                    android:text="Hold transactions until you're on Wi-Fi." />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/obLockSwitch"
                    style="@style/Widget.BankSync.SettingSwitch"
                    android:text="Lock the app" />

                <TextView
                    style="@style/Widget.BankSync.SettingHint"
                    android:text="Ask for your screen lock when opening the app." />
            </LinearLayout>

            <!-- 6: done -->
            <LinearLayout
                android:id="@+id/step6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:contentDescription="@null"
                    style="@style/Widget.BankSync.StepIcon"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You're set"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/obSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Alerts the app can't read are kept under &quot;not understood&quot; so nothing is guessed. You can change everything on the main screen, and reopen this guide from the ⋮ menu."
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next" />
    </LinearLayout>
</LinearLayout>
