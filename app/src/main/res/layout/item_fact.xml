<?xml version="1.0" encoding="utf-8"?>
<!-- One of a record's details in its sheet: the label on the left, the value on the right. A long value
     (the bank alert) goes under its label instead; ActionSheet switches the orientation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/factLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="88dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/factValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:gravity="end"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textIsSelectable="true" />
</LinearLayout>
