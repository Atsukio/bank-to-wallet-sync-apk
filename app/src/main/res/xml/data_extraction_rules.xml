<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" no longer stops a phone-to-phone transfer, so nothing goes either way.
     The token couldn't be read on another phone anyway: its Keystore key never leaves this one. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
